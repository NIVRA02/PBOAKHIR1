<configuration>
  <configSections>
  </configSections>
  <connectionStrings>
    <add name="KOS_BU_IPUNG_PBO.Properties.Settings.DatabasePBOConnectionString"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\..\..\DatabasePBO.mdf;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
